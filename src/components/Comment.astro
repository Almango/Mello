---
import { CommentConfig } from '../config';
import '../styles/waline.css';

const serverURL = CommentConfig.waline.serverURL;
---

<section class="comment">
  <!-- <h2 class="comment-title">评论</h2> -->
  <div id="waline" class="waline-container" data-server-url={serverURL}></div>
</section>

<script is:inline>
  // 把“实际生效的暗色状态”同步到 <html data-dark>，供 Waline 的 dark 选择器匹配。
  // 站点是混合模式：手动切换写 data-theme，auto 模式无 data-theme 时跟随系统偏好。
  function syncDark() {
    const el = document.documentElement;
    const attr = el.getAttribute('data-theme');
    const dark =
      attr === 'dark' ||
      (!attr && window.matchMedia('(prefers-color-scheme: dark)').matches);
    el.setAttribute('data-dark', dark ? 'true' : 'false');
  }
  syncDark();
  new MutationObserver(syncDark).observe(document.documentElement, {
    attributes: true,
    attributeFilter: ['data-theme'],
  });
  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', syncDark);

  (async function () {
    const container = document.getElementById('waline');
    if (!container) return;
    const serverURL = container.getAttribute('data-server-url');
    if (!serverURL) {
      container.textContent = '评论系统配置错误';
      return;
    }
    try {
      const { init } = await import('https://unpkg.com/@waline/client@v3/dist/waline.js');
      init({
        el: '#waline',
        serverURL,
        lang: 'zh-CN',
        dark: 'html[data-dark="true"]',
        reaction: true,
        emoji: [
    'https://unpkg.com/@waline/emojis@1.4.0/bilibili',   // 哔哩哔哩
    'https://unpkg.com/@waline/emojis@1.4.0/weibo',      // 微博
    'https://unpkg.com/@waline/emojis@1.4.0/tw-emoji',   // Twitter Emoji
  ],
      });
    } catch (err) {
      console.error('Waline failed to load:', err);
      container.textContent = '评论系统加载失败，请稍后刷新重试';
    }
  })();
</script>

<style>
  .comment {
    margin-top: 2rem;
  }

  .comment-title {
    font-size: var(--text-title-fontsize);
    font-weight: var(--text-weight);
    color: var(--text-title-color);
    margin: 0 0 1rem;
  }
</style>
