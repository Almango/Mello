---
import { BASE_CONFIG } from '../config'
const navItems = [
  { label: '归档', href: '/archive' },
  { label: '手记', href: '/record' },
  { label: '统计', href: '/statistics' },
  { label: '邻居', href: '/link' },
  { label: '关于', href: '/about' },

]
---
<header>
  <a href="/" class="header-logo">{BASE_CONFIG.subtitle}</a>
  <nav class="header-nav">
    {navItems.map(item => (
      <a href={item.href} class="hover-underline">{item.label}</a>
    ))}
  </nav>
</header>

<style>
  header {
    margin: 0;
    padding: 2rem 0rem 1rem 0rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .header-logo {
    font-size: var(--text-logo-fontsize);
    font-weight: var(--text-weight);
    font-family: "Kaibunsyo";
    text-decoration: none;
    letter-spacing: -0.02em;
    color: var(--text-logo-color);
  }
  .header-nav {
    display: flex;
    gap: 1.5rem;
  }
  .header-nav a {
    font-size: var(--text-content-fontsize);
    color: var(--text-title-color);
    text-decoration: none;
  }
</style>
