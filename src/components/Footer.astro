---
import ThemeToggle from "./ThemeToggle.astro";
import { BASE_CONFIG, FOOTER_CONFIG } from "../config";
---

<footer>
  <span class="footer-copyright">© {BASE_CONFIG.create_time.split("-")[0]} Built with by {BASE_CONFIG.author}.</span>
  <nav class="footer-nav">
    {
      FOOTER_CONFIG.link.map((link) => (
        <a
          href={link.url}
          target={link.url.startsWith("http") ? "_blank" : undefined}
          rel={link.url.startsWith("http") ? "noopener" : undefined}
        >
          {link.name}
        </a>
      ))
    }
    <a href="#"><ThemeToggle /></a>
  </nav>
</footer>

<style>
  footer {
    margin: 0;
    padding: 1rem 0 1.5rem 0;
    border-top: 1px solid var(--line-border-color);
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 1rem;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .footer-copyright {
    font-size: var(--text-description-fontsize);
    color: var(--text-description-color);
  }

  .footer-nav {
    display: flex;
    align-items: center;
  }

  .footer-nav a,
  .footer-nav button {
    font-size: var(--text-description-fontsize);
    color: var(--text-description-color);
    text-decoration: none;
    background: none;
    border: none;
    padding: 0;
    font-family: inherit;
  }

  /* 右侧各项之间用 · 衔接 */
  .footer-nav > *:not(:first-child)::before {
    content: "/";
    margin: 0 0.5rem;
    color: var(--text-description-color);
  }
</style>
