---
interface Props {
  posts: {
    id: string
    data: {
      title: string
      description?: string
      published: Date
      id?: string
    }
  }[]
}

const { posts } = Astro.props
---

<section class="recent">
  <span class="recent-label">RECENT</span>
  <ul class="recent-list">
    {posts.map(post => (
      <li class="recent-item">
        <span class="recent-published">{post.data.published.toISOString().split('T')[0]}</span>
        <a href={`/post/${post.data.id ?? post.id}`} class="recent-title hover-underline">{post.data.title}</a>
        {post.data.description && <p class="recent-description">{post.data.description}</p>}
      </li>
    ))}
  </ul>
  <a href="/archive" class="recent-more hover-underline">显示更多文章 →</a>
</section>

<style>
  .recent {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 2rem 0;
  }

  .recent-label {
    font-size: var(--text-description-fontsize);
    color: var(--text-description-color);
  }

  .recent-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
  }

  .recent-item {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 1rem 0;
    border-bottom: 1px dashed var(--line-divider-color);
  }

  .recent-item:first-child {
    padding-top: 0;
  }

  .recent-item:last-child {
    padding-bottom: 0;
    border-bottom: 0;
  }

  .recent-title {
    font-size: var(--text-title-fontsize);
    color: var(--text-title-color);
    width: fit-content;
    text-decoration: none;
  }

  .recent-description {
    font-size: var(--text-description-fontsize);
    color: var(--text-description-color);
    display: -webkit-box;
    overflow: hidden;
    margin: 0;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  .recent-published {
    font-size: var(--text-description-fontsize);
    color: var(--text-description-color);
  }

  .recent-more {
    font-size: var(--text-description-fontsize);
    color: var(--text-description-color);
    text-decoration: none;
    margin-top: 1rem;
  }
</style>
