---
interface Props {
  posts: {
    id: string
    data: {
      title: string
      description?: string
      published: Date
      tags?: string[]
    }
  }[]
}

const { posts } = Astro.props
---

<ul class="post">
  {posts.map(post => (
    <li class="post-item">
      <a href={`/post/${post.id}`} class="post-link">
        <h2 class="post-title">{post.data.title}</h2>
        {post.data.description && <p class="post-description">{post.data.description}</p>}
      
        <div class="post-meta">
          <span class="post-published">{post.data.published.toISOString().split('T')[0]}</span>
          {post.data.tags && post.data.tags.length > 0 && (
            <span class="post-tags">
              {post.data.tags.map(tag => <span class="post-tag">#{tag}</span>)}
            </span>
          )}
        </div>
        
      </a>
    </li>
  ))}
</ul>

<style>
  .post {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .post-item {
    padding: 1rem 0;
  }

  .post-link {
    display: flex;
    flex-direction: column;
    gap: 8px;
    text-decoration: none;
    color: inherit;
  }

  .post-link:hover .post-title {
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: var(--hover-decoration-thickness);
  }

  .post-title {
    font-size: var(--text-title-fontsize);
    color: var(--text-title-color);
    margin: 0;
  }

  .post-description {
    font-size: calc(var(--text-description-fontsize) + 2.5px);
    color: var(--text-description-color);
    margin: 0;
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }

  .post-published,
  .post-tag {
    font-size: var(--text-description-fontsize);
    color: var(--text-description-color);
  }

  .post-tag {
    color: var(--text-tag-color);
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
</style>
