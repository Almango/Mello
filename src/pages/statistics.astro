---
import Layout from '../layouts/Layout.astro'
import PageHeader from '../components/PageHeader.astro'
import { getCollection } from 'astro:content'
import { BASE_CONFIG } from '../config'

const posts = await getCollection('posts')

const totalPosts = posts.length

let totalWords = 0
posts.forEach(post => {
  let content = post.body
    .replace(/^#{1,6}\s+/gm, '')
    .replace(/\*\*|__|\*|_|`{1,3}|~~/g, '')
    .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
    .replace(/!\[([^\]]*)\]\([^)]+\)/g, '')
    .replace(/^[-*+]\s+/gm, '')
    .replace(/^\d+\.\s+/gm, '')
    .replace(/^>\s+/gm, '')
    .replace(/^---+$/gm, '')
    .replace(/```[\s\S]*?```/g, '')
    .replace(/`[^`]+`/g, '')
  totalWords += content.replace(/[#*`\[\]()>\-\s]/g, '').length
})

const categoryCount = new Set(posts.map(p => p.data.category || '未分类')).size

const createTime = new Date(BASE_CONFIG.create_time)
const now = new Date()
const runDays = Math.floor((now.getTime() - createTime.getTime()) / (1000 * 60 * 60 * 24))

// 分类统计：名称 -> 文章数
const categoryMap = new Map<string, number>()
for (const post of posts) {
  const c = post.data.category || '未分类'
  categoryMap.set(c, (categoryMap.get(c) || 0) + 1)
}

// 标签统计：名称 -> 文章数
const tagMap = new Map<string, number>()
for (const post of posts) {
  for (const t of post.data.tags ?? []) {
    tagMap.set(t, (tagMap.get(t) || 0) + 1)
  }
}

// 根据出现次数映射字号：13px ~ 26px（px 单位）
function cloudSize(count: number, map: Map<string, number>) {
  const max = Math.max(...map.values(), 1)
  return Math.round(13 + (count / max) * 13)
}

const title = '统计'
---

<Layout title={title}>
  <PageHeader title={title} subtitle="博客运行数据一览" />
  <div class="cloud-section">
    <h2 class="cloud-title">总字数 ({(totalWords / 1000).toFixed(1)}k)</h2>
    <h2 class="cloud-title">文章总数 ({totalPosts})</h2>
    <h2 class="cloud-title">分类数量 ({categoryCount})</h2>
    <h2 class="cloud-title">运行时间 ({runDays}天)</h2>
  </div>

  <div class="cloud-section">
    <h2 class="cloud-title">分类 ({categoryMap.size})</h2>
    <div class="cloud">
      {[...categoryMap.entries()].sort((a, b) => b[1] - a[1]).map(([name, count]) => (
        <a
          href={`/category/${name}`}
          class="cloud-item hover-underline"
          style={`font-size: ${cloudSize(count, categoryMap)}px`}
          title={`${count} 篇`}
        >{name}</a>
      ))}
    </div>
  </div>

  <div class="cloud-section">
    <h2 class="cloud-title">标签 ({tagMap.size})</h2>
    <div class="cloud">
      {[...tagMap.entries()].sort((a, b) => b[1] - a[1]).map(([name, count]) => (
        <a
          href={`/tag/${name}`}
          class="cloud-item hover-underline"
          style={`font-size: ${cloudSize(count, tagMap)}px`}
          title={`${count} 篇`}
        >{name}</a>
      ))}
    </div>
  </div>
</Layout>

<style>
  .cloud-section {
    margin-top: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .cloud-section:first-child {
    margin-top: 0;
  }

  .cloud-title {
    font-size: var(--text-title-fontsize);
    color: var(--text-title-color);
    margin: 0;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--line-divider-color);
  }

  .cloud {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    text-align: justify;
    gap: 10px 16px;
  }

  .cloud-item {
    color: var(--text-content-color);
    line-height: 1.6;
    text-decoration: none;
  }
</style>
