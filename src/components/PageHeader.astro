---
interface Props {
  title: string
  subtitle?: string
}

const { title, subtitle } = Astro.props
---

<div class="page-header">
  <h1 class="page-title">{title}</h1>
  {subtitle && <p class="page-subtitle">{subtitle}</p>}
</div>

<style>
  .page-header {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-bottom: 2rem;
    margin-bottom: 2rem;
  }

  .page-header::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100px;
    height: 1px;
    background-color: var(--line-divider-color);
  }

  .page-title {
    font-size: 32px;
    font-weight: var(--text-weight);
    color: var(--text-title-color);
    margin: 0;
  }

  .page-subtitle {
    font-size: var(--text-description-fontsize);
    color: var(--text-description-color);
    margin: 0;
  }
</style>
