---
import Layout from "../../layouts/Layout.astro";
import Comment from "../../components/Comment.astro";
import PostTOC from "../../components/PostTOC.astro";
import { getCollection, render } from "astro:content";
import { POST_CONFIG } from "../../config";
import "github-markdown-css/github-markdown.css";
import "../../styles/markdown.css";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const title = post.data.title;
---

<Layout title={title}>
  <article class="post">
    <header class="post-header">
      <h1 class="post-title">{post.data.title}</h1>
      <time class="post-published"
        >{
          post.data.published.toISOString().slice(0, 19).replace("T", " ")
        }</time
      >
    </header>

    <div class="post-body">
      <div class="post-content markdown-body">
        <Content />
      </div>

      {POST_CONFIG.toc && (
        <aside class="post-toc">
          <div class="post-sticky">
            <PostTOC headings={headings} />
          </div>
        </aside>
      )}
    </div>

    <Comment />
  </article>
</Layout>

<style>
  .post {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding: 2rem 0;
  }

  .post-content {
    font-size: var(--text-content-fontsize);
    color: var(--text-content-color);
    line-height: 1.8;
    text-align: justify;
  }
  .post-header {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .post-title {
    font-size: var(--text-logo-fontsize);
    font-weight: var(--text-weight);
    color: var(--text-title-color);
    margin: 0;
  }
  .post-published {
    font-size: var(--text-description-fontsize);
    color: var(--text-description-color);
  }

  .post-body {
    position: relative;
  }

  .post-toc {
    position: absolute;
    top: 0;
    right: -200px;
    width: 180px;
    height: 100%;
  }
  .post-sticky {
    position: sticky;
    top: 2rem;
    max-height: calc(100vh - 4rem);
    overflow-y: auto;
  }

  /* 视口宽度放不下右侧浮动目录时隐藏 */
  @media (max-width: 1240px) {
    .post-toc {
      display: none;
    }
  }

  /* 开启全局平滑滚动 */
  :global(html) {
    scroll-behavior: smooth;
  }
  /* 锚点跳转到标题时，标题上方预留的空间 */
  :global(.markdown-body h2),
  :global(.markdown-body h3) {
    scroll-margin-top: 1.4rem;
  }
</style>
