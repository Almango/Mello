---
// 主题切换组件
---

<button type="button" data-theme-toggle class="theme-toggle" aria-label="切换主题">
  <svg class="icon-sun" xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24">
    <path d="M0 0h24v24H0z" fill="none" />
    <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2">
      <circle cx="12" cy="12" r="4" />
      <path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32l1.41 1.41M2 12h2m16 0h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
    </g>
  </svg>
  <svg class="icon-moon" xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24">
    <path d="M0 0h24v24H0z" fill="none" />
    <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401" />
  </svg>
</button>

<style>
  .theme-toggle {
    cursor: pointer;
    background: 0;
    border: 0;
    border-radius: 50%;
    place-items: center;
    padding: 0;
    display: grid;

  }

  .theme-toggle svg {
    width: 18px;
    height: 18px;
  }

  /* 亮色显示月亮（点击切到暗色），暗色显示太阳 */
  .icon-sun {
    display: none;
  }

  :global(html[data-theme="dark"]) .icon-moon {
    display: none;
  }

  :global(html[data-theme="dark"]) .icon-sun {
    display: block;
  }
</style>

<script>
  (() => {
    const FLAG = '__ThemeToggleInitialized'

    if (window[FLAG]) return
    window[FLAG] = true

    const root = document.documentElement
    const STORAGE_KEY = 'theme'

    // 初始主题已在 <head> 的 ThemeInit 中同步设置，这里只负责切换
    const applyTheme = (theme) => {
      root.dataset.theme = theme
      root.classList.toggle('dark', theme === 'dark')
      root.style.colorScheme = theme
    }

    const toggle = () => {
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark'

      applyTheme(next)

      try {
        localStorage.setItem(STORAGE_KEY, next)
      } catch {}
    }

    document.addEventListener('click', (event) => {
      const target = event.target
      if (!(target instanceof Element)) return
      if (target.closest('[data-theme-toggle]')) toggle()
    })
  })()
</script>
