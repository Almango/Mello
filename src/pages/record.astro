---
import Layout from '../layouts/Layout.astro'
import { getCollection } from 'astro:content'

const allPosts = await getCollection('posts')
const posts = allPosts
  .filter(post => post.data.category === '往尘手记')
  .sort((a, b) => {
    return new Date(b.data.published).getTime() - new Date(a.data.published).getTime()
  })

const title = '往尘手记'
---

<Layout title={title}>
	<ul class="record">
	  {posts.map(post => (
	    <li class="record-item">
	      <span class="record-published">{post.data.published.toISOString().split('T')[0]}</span>
	      <a href={`/post/${post.id}`} class="record-title">{post.data.title}</a>
	    </li>
	  ))}
	</ul>
</Layout>

<style>
  .record {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .record-item {
    display: flex;
    align-items: baseline;
    gap: 10px;
    padding: .75rem 0;
  }

  .record-published {
    font-size: var(--text-content-fontsize);
    color: var(--text-description-color);
    flex-shrink: 0;
    min-width: 6rem;
  }

  .record-title {
    font-size: var(--text-content-fontsize);
    color: var(--text-logo-color);
    text-decoration: none;
  }

  .record-title:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: var(--hover-decoration-thickness);
  }
</style>
