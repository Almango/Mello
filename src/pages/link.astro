---
import Layout from '../layouts/Layout.astro'
import PageHeader from '../components/PageHeader.astro'
import { links } from '../data/links.ts'
import Comment from '../components/Comment.astro'
import { Content } from '../content/link.md'
import '../styles/markdown.css'


const title = '友链'
---

<Layout title={title}>
  <PageHeader title={title} subtitle="海内存知己，天涯若比邻" />
  <div class="link">
    <div class="link-top">
      {links.map(link => (
        <div class="link-item">
          <img src={link.avatar} alt={link.name} class="link-avatar" />
          <div class="link-info">
            <a href={link.url} target="_blank" rel="noopener" class="link-name hover-underline">{link.name}</a>
            <span class="link-description">{link.description}</span>
          </div>
        </div>
      ))}
    </div>
    <div class="link-bottom markdown-body">
      <Content />
    </div>
    <Comment />
  </div>
</Layout>

<style>
  .link {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding: 1rem 0;
  }

  .link-top {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 16px;
  }

.link-item {
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 0.75rem;
  background: var(--bg-surface);
  filter:
    drop-shadow(0 1px 1px var(--shadow-color))
    drop-shadow(0 4px 10px var(--shadow-color));
  clip-path: polygon(
    1% 4%, 4% 0%, 20% 2%, 36% 0%, 53% 2%, 69% 0%, 85% 2%, 98% 1%,
    100% 6%, 98% 25%, 100% 48%, 98% 70%, 100% 90%, 97% 99%, 80% 98%,
    62% 100%, 45% 98%, 28% 100%, 12% 98%, 2% 100%, 0% 93%, 2% 72%,
    0% 50%, 2% 27%
  );
}

  .link-avatar {
    width: 46px;
    height: 46px;
    object-fit: cover;
    flex-shrink: 0;
  }

  .link-info {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .link-name {
    font-size: var(--text-content-fontsize);
    font-weight: var(--text-weight);
    color: var(--text-title-color);
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    text-decoration: none;
  }

  .link-description {
    font-size: var(--text-description-fontsize);
    color: var(--text-description-color);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .link-bottom {
    font-size: var(--text-content-fontsize);
    color: var(--text-content-color);
    line-height: 1.8;
  }
</style>
