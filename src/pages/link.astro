---
import Layout from '../layouts/Layout.astro'
import PageHeader from '../components/PageHeader.astro'
import { links } from '../data/links.ts'
import Comment from '../components/Comment.astro'
import { Content } from '../content/link.md'
import '../styles/markdown.css'


const title = '友链'
---

<Layout title={title}>
  <PageHeader title={title} subtitle="海内存知己，天涯若比邻" />
  <div class="link">
    <div class="link-top">
      {links.map(link => (
        <div
          class:list={['link-item', link.avatar && 'has-avatar']}
          style={link.avatar ? `--card-avatar: url("${link.avatar}")` : undefined}
        >
          <div class="link-info">
            <a href={link.url} target="_blank" rel="noopener" class="link-name">{link.name}</a>
            <span class="link-description">{link.description}</span>
          </div>
        </div>
      ))}
    </div>
    <div class="link-bottom markdown-body">
      <Content />
    </div>
    <Comment />
  </div>
</Layout>

<style>
  .link {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding: 1rem 0;
  }

  .link-top {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 16px;
  }

.link-item {
  position: relative;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 0.75rem;
  overflow: hidden;
  background: var(--bg-surface);
  border: 1px solid var(--border-color);
  user-select: none;
}

.link-item.has-avatar::after {
  content: "";
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  background-image: var(--card-avatar);
  background-size: cover;
  background-position: center;
  -webkit-mask-image: linear-gradient(
    to left,
    rgba(0, 0, 0, 0.6) 0%,
    rgba(0, 0, 0, 0.4) 20%,
    rgba(0, 0, 0, 0.2) 50%,
    rgba(0, 0, 0, 0.08) 60%,
    rgba(0, 0, 0, 0.02) 70%,
    rgba(0, 0, 0, 0) 80%,
    transparent 100%
  );
  mask-image: linear-gradient(
    to left,
    rgba(0, 0, 0, 0.6) 0%,
    rgba(0, 0, 0, 0.4) 20%,
    rgba(0, 0, 0, 0.2) 50%,
    rgba(0, 0, 0, 0.08) 60%,
    rgba(0, 0, 0, 0.02) 70%,
    rgba(0, 0, 0, 0) 80%,
    transparent 100%
  );
  pointer-events: none;
}

  .link-info {
    /* 作为 flex 项可直接使用 z-index；不设 position，避免成为拉伸链接 ::after 的包含块 */
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 4px;
    flex: 1 1 auto;
    min-width: 0;
    max-width: 100%;
  }

  .link-name {
    font-size: var(--text-content-fontsize);
    font-weight: var(--text-weight);
    color: var(--text-title-color);
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    text-decoration: none;
  }

  /* 拉伸链接：伪元素以 .link-item（position: relative）为包含块铺满整卡 */
  .link-name::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .link-name:focus-visible {
    outline: none;
  }

  .link-name:focus-visible::after {
    outline: 2px solid var(--text-title-color);
    outline-offset: -2px;
  }

  .link-description {
    font-size: var(--text-description-fontsize);
    color: var(--text-description-color);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .link-bottom {
    font-size: var(--text-content-fontsize);
    color: var(--text-content-color);
    line-height: 1.8;
  }
</style>
