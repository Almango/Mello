---
interface Props {
  posts: {
    id: string
    data: {
      title: string
      description?: string
      published: Date
      id?: string
    }
  }[]
}

const { posts } = Astro.props

type Post = Props['posts'][number]

const dateOf = (post: Post) => post.data.published.toISOString().slice(0, 10).replaceAll('-', '.')
const isoOf = (post: Post) => post.data.published.toISOString()
const hrefOf = (post: Post) => `/post/${post.data.id ?? post.id}`
---

<section class="recent">
  <h2 class="recent-heading">最新文章</h2>

  <ul class="recent-list">
    {posts.slice(0, 4).map((post) => (
      <li class="recent-item">
        <time class="recent-published" datetime={isoOf(post)}>{dateOf(post)}</time>
        <div class="recent-body">
          <a href={hrefOf(post)} class="recent-title hover-underline">{post.data.title}</a>
          {post.data.description && <p class="recent-description">{post.data.description}</p>}
        </div>
      </li>
    ))}
  </ul>

  <a href="/archive" class="recent-more hover-underline">浏览更多文章 →</a>
</section>

<style>
  .recent {
    padding: 32px 0;
  }

  .recent-heading {
    margin: 0 0 4px;
    color: var(--text-content-color);
    font-size: var(--text-content-fontsize);;
    font-weight: var(--text-weight);
  }

  .recent-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .recent-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 16px 0;
    border-bottom: 1px dashed var(--line-divider-color);
  }

  .recent-published {
    color: var(--text-description-color);
    font-size: 14px;
    font-variant-numeric: tabular-nums;
    line-height: 1.6;
  }

  .recent-body {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .recent-title {
    color: var(--text-title-color);
    font-weight: var(--text-weight);
    font-size: 18px;
    line-height: 1.6;
    overflow-wrap: anywhere;
    text-decoration: none;
  }

  .recent-description {
    display: -webkit-box;
    overflow: hidden;
    margin: 0;
    color: var(--text-description-color);
    font-size: 13px;
    line-height: 1.6;
    overflow-wrap: anywhere;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .recent-more {
    display: inline-block;
    margin-top: 16px;
    color: var(--text-content-color);
    font-size: var(--text-description-fontsize);
    text-decoration: none;
  }

</style>
