---
import Layout from '../layouts/Layout.astro'
import { links } from '../data/links.ts'
import Comment from '../components/Comment.astro'


const title = '友链'
---

<Layout title={title}>
  <div class="link">
    <div class="link-top">
      {links.map(link => (
        <div class="link-item">
          <img src={link.avatar} alt={link.name} class="link-avatar" />
          <div class="link-info">
            <a href={link.url} target="_blank" rel="noopener" class="link-name hover-underline">{link.name}</a>
            <span class="link-description">{link.description}</span>
          </div>
        </div>
      ))}
    </div>
    <div class="link-bottom">
      <h3>友链申请</h3>
      <p>海内存知己，天涯若比邻，很高兴能在这里与你相遇，如果你也和我一样，热爱记录、用心经营自己的小天地，欢迎常来坐坐，期待与你交换友链。</p>
      <p>请按照以下格式提交至评论区或者发送至我的邮箱，最快会在24小时内处理好申请。</p>
    </div>
    <Comment />
  </div>
</Layout>

<style>
  .link {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .link-top {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
  }

  .link-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: .75rem 0;
  }

  .link-avatar {
    width: 46px;
    height: 46px;
    object-fit: cover;
    flex-shrink: 0;
  }

  .link-info {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .link-name {
    font-size: var(--text-content-fontsize);
    font-weight: var(--text-weight);
    color: var(--text-title-color);
    width: fit-content;
    text-decoration: none;
  }

  .link-description {
    font-size: var(--text-description-fontsize);
    color: var(--text-description-color);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  @media (max-width: 768px) {
    .link-top {
      grid-template-columns: 1fr;
    }
  }

  .link-bottom {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .link-bottom h3 {
    font-size: var(--text-title-fontsize);
    color: var(--text-title-color);
    margin: 0;
  }

  .link-bottom p {
    font-size: var(--text-content-fontsize);
    color: var(--text-content-color);
    margin: 0;
  }
</style>
