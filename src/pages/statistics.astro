---
import Layout from '../layouts/Layout.astro'
import { getCollection } from 'astro:content'
import { BASE_CONFIG } from '../config'

const posts = await getCollection('posts')

const totalPosts = posts.length

let totalWords = 0
posts.forEach(post => {
  let content = post.body
    .replace(/^#{1,6}\s+/gm, '')
    .replace(/\*\*|__|\*|_|`{1,3}|~~/g, '')
    .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
    .replace(/!\[([^\]]*)\]\([^)]+\)/g, '')
    .replace(/^[-*+]\s+/gm, '')
    .replace(/^\d+\.\s+/gm, '')
    .replace(/^>\s+/gm, '')
    .replace(/^---+$/gm, '')
    .replace(/```[\s\S]*?```/g, '')
    .replace(/`[^`]+`/g, '')
  totalWords += content.replace(/[#*`\[\]()>\-\s]/g, '').length
})

const categoryCount = new Set(posts.map(p => p.data.category || '未分类')).size

const createTime = new Date(BASE_CONFIG.create_time)
const now = new Date()
const runDays = Math.floor((now.getTime() - createTime.getTime()) / (1000 * 60 * 60 * 24))

const title = '统计'
---

<Layout title={title}>
  <ul class="statistics">
    <li class="statistics-item">
      <span class="statistics-label">总字数</span>
      <span class="statistics-value">{(totalWords / 1000).toFixed(1)}k</span>
    </li>
    <li class="statistics-item">
      <span class="statistics-label">文章总数</span>
      <span class="statistics-value">{totalPosts}</span>
    </li>
    <li class="statistics-item">
      <span class="statistics-label">分类数量</span>
      <span class="statistics-value">{categoryCount}</span>
    </li>
    <li class="statistics-item">
      <span class="statistics-label">运行时间</span>
      <span class="statistics-value">{runDays}天</span>
    </li>
  </ul>
</Layout>

<style>
  .statistics {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .statistics-item {
    display: flex;
    align-items: baseline;
    gap: 24px;
    padding: .75rem 0;
  }

  .statistics-label {
    font-size: var(--text-content-fontsize);
    color: var(--text-description-color);
    flex-shrink: 0;
    min-width: 4rem;
  }

  .statistics-value {
    font-size: var(--text-content-fontsize);
    color: var(--text-logo-color);
  }
</style>
