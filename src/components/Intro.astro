---
import { Icon } from 'astro-icon/components'
import { BASE_CONFIG } from '../config'
import HeatChart from './HeatChart.astro'

const links: { label: string; href: string; icon: string; external?: boolean }[] = [
  { label: 'GitHub', href: 'https://github.com/Almango', icon: 'tabler:brand-github', external: true },
  { label: 'Email', href: 'mailto:silveralmango@outlook.com', icon: 'tabler:mail' },
  { label: 'Steam', href: '/rss.xml', icon: 'tabler:brand-steam' },
  { label: 'RSS', href: '/rss.xml', icon: 'tabler:rss' },
]
---

<section class="intro">
  <div class="intro-content">
    <p class="intro-title">你好，我是{BASE_CONFIG.author}。</p>

    <p class="intro-description">
      {BASE_CONFIG.description}。
      <br />
      想让随手写的日常成为未来宝贵的回忆，仅此而已。
    </p>

    <ul class="intro-links">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            target={link.external ? '_blank' : undefined}
            rel={link.external ? 'noopener' : undefined}
          >
            <Icon name={link.icon} size={16} aria-hidden="true" />
            <span>{link.label}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>

  <div class="intro-portrait">
    <img
      class="intro-avatar"
      src={BASE_CONFIG.avatar}
      alt={`${BASE_CONFIG.author}的头像`}
      />
  </div>
</section>

<div class="intro-heatmap">
  <HeatChart />
</div>

<style>
  .intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: stretch;
    gap: 2rem;
    padding-top: 2rem;
  }

  .intro-content {
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
    min-width: 0;
  }

  .intro-title {
    margin: 0;
    color: var(--text-subtitle-color);
    font-size: var(--text-logo-fontsize);
    font-weight: var(--text-weight);
    font-family: "Noto serif SC", serif;
    line-height: 1.3;
  }

  .intro-description {
    margin: 0;
    color: var(--text-content-color);
    font-size: var(--text-content-fontsize);
    line-height: 2;
  }

  .intro-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .intro-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: "Noto serif SC", serif;
    color: var(--text-description-color);
    font-size: 13px;
    text-decoration: none;
  }

  .intro-links :global(svg) {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }

  .intro-portrait {
    --portrait-rotate: -4deg;
    box-sizing: border-box;
    flex: none;
    width: 140px;
    height: 140px;
    padding: 8px;
    overflow: hidden;
    background-color: var(--bg-surface);
    transform: rotate(var(--portrait-rotate));
  }

  .intro-avatar {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .intro-heatmap {
    margin-top: 1.4rem;
    padding-bottom: 2rem;
    border-bottom: 1px dashed var(--line-divider-color);
  }

  @media (max-width: 640px) {
    .intro {
      grid-template-columns: 1fr;
      gap: 1.25rem;
      padding-top: 1.5rem;
    }

    .intro-content {
      gap: 1.25rem;
    }

    .intro-title {
      font-size: 28px;
    }

    .intro-portrait {
      display: none;
    }

    .intro-heatmap {
      margin-top: 1.25rem;
      padding-bottom: 2rem;
    }
  }
</style>
