---
import Layout from '../layouts/Layout.astro'
import PageHeader from '../components/PageHeader.astro'
import { getCollection } from 'astro:content'

const posts = await getCollection('posts')

// 分类统计：名称 -> 文章数
const categoryMap = new Map<string, number>()
for (const post of posts) {
  const c = post.data.category || '未分类'
  categoryMap.set(c, (categoryMap.get(c) || 0) + 1)
}

// 标签统计：名称 -> 标签数
const tagMap = new Map<string, number>()
for (const post of posts) {
  for (const t of post.data.tags ?? []) {
    tagMap.set(t, (tagMap.get(t) || 0) + 1)
  }
}

const title = '探索'
---

<Layout title={title}>
  <PageHeader title={title} subtitle="浏览分类与标签" />
  <div class="explore-section">
    <h2 class="explore-title">分类 ({categoryMap.size})</h2>
    <div class="explore">
      {[...categoryMap.entries()].sort((a, b) => b[1] - a[1]).map(([name, count]) => (
        <a
          href={`/category/${name}`}
          class="explore-item hover-underline"
          title={`${count} 篇`}
        >{name}</a>
      ))}
    </div>
  </div>

  <div class="explore-section">
    <h2 class="explore-title">标签 ({tagMap.size})</h2>
    <div class="explore">
      {[...tagMap.entries()].sort((a, b) => b[1] - a[1]).map(([name, count]) => (
        <a
          href={`/tag/${name}`}
          class="explore-item hover-underline"
          title={`${count} 篇`}
        >{name}</a>
      ))}
    </div>
  </div>
</Layout>

<style>
  .explore-section {
    margin-top: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .explore-section:first-child {
    margin-top: 0;
  }

  .explore-title {
    margin: 0;
    padding-bottom: 0.5rem;
    font-size: var(--text-content-fontsize);
    color: var(--text-content-color);
    border-bottom: 1px solid var(--line-divider-color);
  }

  .explore {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    text-align: justify;
    gap: 10px 16px;
  }

  .explore-item {
    color: var(--text-content-color);
    text-decoration: none;
    padding: 2px 8px;
    border: 1px solid var(--line-divider-color);
    font-size: var(--text-description-fontsize);
  }

  .explore-item:hover {
    border-color: var(--text-content-color);
  }
</style>